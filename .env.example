# --- Développement (npm run dev) --------------------------------------------
# L'application appelle /api ; Vite relaie la requête vers VITE_PROXY_TARGET (aucun souci de CORS).
VITE_API_URLS=/api

# Serveur EN LIGNE :
VITE_PROXY_TARGET=https://edvia-backend.onrender.com
# Serveur LOCAL (npm start dans le dossier backend) :
# VITE_PROXY_TARGET=http://localhost:3001

# --- Application déployée (Render, Static Site) --------------------------------
# Adresse(s) directe(s) du serveur, par ordre de priorité. Le serveur doit alors autoriser l'adresse de l'application
# (variable CORS_ORIGIN du backend).
# VITE_API_URLS=https://edvia-backend.onrender.com/api
